---
/** A compact personal home screen for phones and tablets. */
import { ArrowUpRight, Download, FileUser, GraduationCap, Trophy } from 'lucide-react';
import AppIcon from '../icons/AppIcon.tsx';
import { initials, profile } from '../../lib/content/site-data.ts';
import { localePaths } from '../../lib/content/urls.ts';
import type { Locale } from '../../lib/i18n/locales.ts';
import { text } from '../../lib/i18n/text.ts';
import { useTranslations } from '../../lib/i18n/ui.ts';
import { sectionsFor } from '../../lib/site/sections.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const paths = localePaths(locale);
const t = useTranslations(locale);
const apps = sectionsFor(locale);
const copy = locale === 'tr' ? {
  introduction: 'Güvenilir backend sistemleri geliştiriyor, öğrendiklerimi projelerim ve teknik yazılarımla paylaşıyorum.',
  projects: 'Projelerim',
  cv: 'CV’mi indir',
  achievements: 'Öne çıkan çalışmalarım',
  firstPlace: 'Trabzon Birinciliği',
  finalist: 'All-Star Finalisti',
  captain: 'Takım Kaptanı',
  capstone: 'Bitirme tez projem',
  funded: 'TÜBİTAK 2209-A destekli',
  viewProject: 'Projeyi incele',
} : {
  introduction: 'I build reliable backend systems and share what I learn through my projects and technical writing.',
  projects: 'My projects',
  cv: 'Download CV',
  achievements: 'Featured work',
  firstPlace: 'Trabzon First Place',
  finalist: 'All-Star Finalist',
  captain: 'Team Captain',
  capstone: 'University capstone',
  funded: 'Funded by TÜBİTAK 2209-A',
  viewProject: 'View project',
};
const turkcellAward = profile.awards?.find((award) => award.icon === 'trophy');
const educonnectAward = profile.awards?.find((award) => award.icon === 'award');
---

<main class="mobile-home" id="mobile-icerik" tabindex="-1">
  <section class="mobile-home__profile" aria-labelledby="mobile-profile-name">
    <div class="mobile-home__identity">
      <a class="mobile-home__portrait" href={paths.about} aria-label={`${profile.name} — ${t.sections.about.label}`}>
        {
          profile.avatar ? (
            <img src={profile.avatar} alt={text(profile.avatarAlt, locale)} width="72" height="72" fetchpriority="high" />
          ) : (
            <span aria-hidden="true">{initials(profile.name)}</span>
          )
        }
      </a>
      <div class="mobile-home__identity-text">
        <h1 id="mobile-profile-name">{profile.name}</h1>
        <p>{text(profile.title, locale)}</p>
      </div>
    </div>

    <div class="mobile-home__technologies" aria-label={t.about.skills}>
      <span>Java <span aria-hidden="true">/</span> Spring Boot</span>
      <span>C# <span aria-hidden="true">/</span> ASP.NET Core</span>
    </div>

    <p class="mobile-home__introduction">{copy.introduction}</p>

    <div class="mobile-home__actions">
      <a class="mobile-home__action mobile-home__action--primary" href={paths.projects}>
        <span>{copy.projects}</span>
        <ArrowUpRight size={17} strokeWidth={2} aria-hidden="true" />
      </a>
      {
        profile.cv && (
          <a class="mobile-home__action mobile-home__action--cv" href={profile.cv} download>
            <Download size={16} strokeWidth={1.8} aria-hidden="true" />
            <span>{copy.cv}</span>
          </a>
        )
      }
    </div>
  </section>

  <section class="mobile-home__achievements" aria-label={copy.achievements}>
    {
      turkcellAward && (
        <a class="mobile-home__achievement mobile-home__achievement--turkcell" href={paths.project('turkcell-skillhub')} aria-label={`${text(turkcellAward.title, locale)} — ${text(turkcellAward.detail, locale)}. ${copy.viewProject}`}>
          <span class="mobile-home__achievement-top">
            <span class="mobile-home__award-icon mobile-home__award-icon--gold"><Trophy size={25} strokeWidth={1.5} aria-hidden="true" /></span>
            <ArrowUpRight className="mobile-home__award-link" size={15} aria-hidden="true" />
          </span>
          <span class="mobile-home__award-eyebrow">Turkcell Code Night</span>
          <strong class="mobile-home__award-title">{copy.firstPlace}</strong>
          <span class="mobile-home__award-detail">{copy.finalist}<br />{copy.captain}</span>
        </a>
      )
    }
    {
      educonnectAward && (
        <a class="mobile-home__achievement mobile-home__achievement--educonnect" href={paths.project('educonnect')} aria-label={`${text(educonnectAward.title, locale)} — ${text(educonnectAward.detail, locale)}. ${copy.capstone}. ${copy.viewProject}`}>
          <span class="mobile-home__achievement-top">
            <span class="mobile-home__award-icon mobile-home__award-icon--blue"><GraduationCap size={27} strokeWidth={1.5} aria-hidden="true" /></span>
            <ArrowUpRight className="mobile-home__award-link" size={15} aria-hidden="true" />
          </span>
          <span class="mobile-home__award-eyebrow">{copy.capstone}</span>
          <strong class="mobile-home__award-title">EduConnect</strong>
          <span class="mobile-home__award-detail">{copy.funded}</span>
        </a>
      )
    }
  </section>

  <nav class="mobile-home__apps" aria-label={t.home.apps}>
    <ul>
      {
        apps.map((app) => (
          <li>
            <a class="mobile-home__app" href={app.href}>
              <AppIcon name={app.icon} />
              <span class="mobile-home__app-label">{app.shortLabel}</span>
            </a>
          </li>
        ))
      }
      {
        profile.cv && (
          <li>
            <a class="mobile-home__app" href={profile.cv} download aria-label={copy.cv}>
              <span class="mobile-home__cv-icon" aria-hidden="true">
                <FileUser size={35} strokeWidth={1.3} />
                <span>PDF</span>
              </span>
              <span class="mobile-home__app-label">{t.about.cv}</span>
            </a>
          </li>
        )
      }
      <li>
        <a class="mobile-home__app" href={paths.search} data-open-search aria-haspopup="dialog">
          <AppIcon name="search" />
          <span class="mobile-home__app-label">{t.sections.search.short}</span>
        </a>
      </li>
    </ul>
  </nav>
</main>
