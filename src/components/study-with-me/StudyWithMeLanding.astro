---
/**
 * Tao: Cozy Focus Timer ürün sayfası.
 *
 * Sayfa uygulamanın kendisi gibi davranır: tepesi odadır, ışığı ziyaretçinin saatidir
 * ve arkadaş, uygulamadaki kendi cümleleriyle sayfayı gezdirir. Uygulamayı gösteren her
 * görüntü gerçek bir ekran görüntüsünden kesilir (`scripts/tasarim/tao-gorselleri.mjs`).
 */
import { languageHref } from '../../lib/i18n/locales';
import Closing from './Closing.astro';
import Company from './Company.astro';
import Notebook from './Notebook.astro';
import RoomHero from './RoomHero.astro';
import RoomLight from './RoomLight.astro';
import RoomShelf from './RoomShelf.astro';
import SessionStory from './SessionStory.astro';
import Wardrobe from './Wardrobe.astro';
import { landingCopy } from './landing-copy';
import type { LandingLanguage } from './landing-copy';
import measures from './room-measures.json';
import './landing.css';
import './room.css';
import './story.css';
import './studio.css';
import './places.css';

interface Props {
  lang: LandingLanguage;
}

const { lang } = Astro.props;
const copy = landingCopy[lang];
const otherLanguage = lang === 'tr' ? 'en' : 'tr';
const imagePath = '/studywithme/images/';
const canonical = new URL(copy.path, Astro.site ?? Astro.url);
const alternate = new URL(copy.alternate, canonical);
const socialImage = new URL(imagePath + 'social.jpg', canonical);
const walls = {
  day: measures.wide.light.day.wall,
  evening: measures.wide.light.evening.wall,
  night: measures.wide.light.night.wall,
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <RoomLight colours={walls} />
    <title>{copy.title}</title>
    <meta name="description" content={copy.description} />
    <meta property="og:title" content={copy.title} />
    <meta property="og:description" content={copy.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={socialImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={copy.roomAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang={lang} href={canonical.href} />
    <link rel="alternate" hreflang={otherLanguage} href={alternate.href} />
    <link rel="icon" href={imagePath + 'app-icon.webp'} type="image/webp" />
    <link rel="preload" href="/studywithme/fonts/shantellsans-semibold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/studywithme/fonts/shantellsans-regular.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#content">{copy.skip}</a>

    <RoomHero lang={lang} />

    <main id="content">
      <SessionStory lang={lang} />
      <Wardrobe lang={lang} />
      <RoomShelf lang={lang} />
      <Notebook lang={lang} />
      <Company lang={lang} />
      <Closing lang={lang} />
    </main>

    <footer class="site-footer">
      <div class="site-width footer-inner">
        <div>
          <a class="brand" href={copy.path}>
            <img src={imagePath + 'app-icon.webp'} alt="" width="40" height="40" loading="lazy" />
            <span lang="en">Tao: Cozy Focus Timer</span>
          </a>
          <p>{copy.localData}</p>
        </div>
        <nav class="footer-links" aria-label={copy.nav}>
          <a href={copy.support}>{copy.supportLabel}</a>
          <a href={copy.privacy}>{copy.privacyLabel}</a>
          <a href={languageHref(copy.directory, lang)}>{copy.directoryLabel} <span aria-hidden="true">↗</span></a>
        </nav>
        <p class="trademark">{copy.trademark}</p>
      </div>
    </footer>
    <script>
      // Sayfa aşağı indikçe parçalar belirir. Betik çalışmazsa hepsi baştan görünür (bkz. landing.css).
      const pieces = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const watcher = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-in');
            watcher.unobserve(entry.target);
          }
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
        pieces.forEach((piece) => watcher.observe(piece));
      } else {
        pieces.forEach((piece) => piece.classList.add('is-in'));
      }
    </script>
  </body>
</html>
