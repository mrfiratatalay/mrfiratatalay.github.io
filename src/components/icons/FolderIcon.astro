---
/** Finder mavisini, üst sekmeyi ve katmanlı kenarı koruyan özgün klasör. */
import type { IconName } from '../../lib/site/sections.ts';
import SectionIcon from './SectionIcon.tsx';

interface Props {
  icon?: IconName;
  color?: 'blue' | 'yellow' | 'green' | 'purple' | 'pink' | 'orange';
  size?: 'normal' | 'large';
}

const { icon, color = 'blue', size = 'normal' } = Astro.props;
---

<span class:list={['folder', `folder--${color}`, { 'folder--large': size === 'large' }]} aria-hidden="true">
  <span class="folder__back"></span>
  <span class="folder__front">{icon && <SectionIcon name={icon} strokeWidth={1.8} />}</span>
</span>
