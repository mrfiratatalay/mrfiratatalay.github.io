---
import type { BlogPost } from '../../lib/content/collections.ts';
import { formatDate, isoDate } from '../../lib/content/dates.ts';
import { publicImageSize } from '../../lib/content/images.ts';
import { readingMinutes } from '../../lib/content/rules.ts';
import { categoryLabel } from '../../lib/content/site-data.ts';
import { localePaths } from '../../lib/content/urls.ts';
import { DEFAULT_LOCALE, type Locale } from '../../lib/i18n/locales.ts';
import { useTranslations } from '../../lib/i18n/ui.ts';
import CategoryGlyph, { categoryTint } from '../icons/CategoryGlyph.tsx';

interface Props {
  locale: Locale;
  post: BlogPost;
  featured?: boolean;
}

const { locale, post, featured = false } = Astro.props;
const { data } = post;
const t = useTranslations(locale);
const size = await publicImageSize(data.cover);
const label = categoryLabel(data.category, locale);
const contentLang = data.lang ?? DEFAULT_LOCALE;
---

<article class:list={['card', { 'card--featured': featured }]}>
  <div class="card__media" style={`--tint: ${categoryTint(data.category)}`}>
    {
      data.cover ? (
        <img
          src={data.cover}
          alt={data.coverAlt ?? ''}
          width={size?.width}
          height={size?.height}
          loading={featured ? 'eager' : 'lazy'}
          decoding="async"
        />
      ) : (
        <span class="card__art" aria-hidden="true">
          <span class="card__tile card__glyph">
            <CategoryGlyph category={data.category} />
          </span>
        </span>
      )
    }
  </div>
  <div class="card__body">
    {
      (label || contentLang !== locale) && (
        <p class="card__kicker">
          {label && <span class="pill">{label}</span>}
          {contentLang !== locale && <span class="pill pill--neutral">{t.content.languageName[contentLang]}</span>}
        </p>
      )
    }
    <h2 class="card__title" lang={contentLang}>
      <a href={localePaths(locale).blogPost(data.urlSlug)}>{data.title}</a>
    </h2>
    {data.description && <p class="card__text" lang={contentLang}>{data.description}</p>}
    <ul class="card__meta">
      <li><time datetime={isoDate(data.publishedAt)}>{formatDate(data.publishedAt, locale)}</time></li>
      <li>{t.blog.readingTime(readingMinutes(post.body ?? ''))}</li>
    </ul>
  </div>
</article>
