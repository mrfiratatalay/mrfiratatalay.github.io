---
import type { MarkdownHeading } from 'astro';
import { hasToc, tocItems } from '../../lib/content/toc.ts';

interface Props {
  headings: MarkdownHeading[];
  variant: 'sidebar' | 'inline';
}

const { headings, variant } = Astro.props;
const items = tocItems(headings);
---

{
  hasToc(headings) &&
    (variant === 'sidebar' ? (
      <nav class="sidebar-section" data-toc aria-label="Bu sayfada" data-pagefind-ignore>
        <p class="sidebar-heading">Bu sayfada</p>
        <ul class="sidebar-list">
          {items.map((heading) => (
            <li>
              <a class={`sidebar-link sidebar-link--toc depth-${heading.depth}`} href={`#${heading.slug}`}>
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ) : (
      <details class="toc-inline" data-pagefind-ignore>
        <summary>İçindekiler ({items.length} başlık)</summary>
        <nav aria-label="İçindekiler">
          <ol>
            {items.map((heading) => (
              <li class={`depth-${heading.depth}`}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      </details>
    ))
}
