---
import type { MarkdownHeading } from 'astro';
import { hasToc, tocItems } from '../../lib/content/toc.ts';
import type { Locale } from '../../lib/i18n/locales.ts';
import { useTranslations } from '../../lib/i18n/ui.ts';

interface Props {
  locale: Locale;
  headings: MarkdownHeading[];
  variant: 'sidebar' | 'inline';
}

const { locale, headings, variant } = Astro.props;
const t = useTranslations(locale).content;
const items = tocItems(headings);
---

{
  hasToc(headings) &&
    (variant === 'sidebar' ? (
      <nav class="sidebar-section" data-toc aria-label={t.onThisPage} data-pagefind-ignore>
        <p class="sidebar-heading">{t.onThisPage}</p>
        <ul class="sidebar-list">
          {items.map((heading) => (
            <li>
              <a class={`sidebar-link sidebar-link--toc depth-${heading.depth}`} href={`#${heading.slug}`}>
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ) : (
      <details class="toc-inline" data-pagefind-ignore>
        <summary>{t.contentsCount(items.length)}</summary>
        <nav aria-label={t.contents}>
          <ol>
            {items.map((heading) => (
              <li class={`depth-${heading.depth}`}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      </details>
    ))
}
