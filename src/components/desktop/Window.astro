---
/**
 * Finder esinli pencere: kenar çubuğu (Favoriler + sayfaya özel bölümler),
 * sistem araç çubuğu ve kaydırılan içerik. İçerik Astro'nun
 * ürettiği HTML olarak kalır; davranışı pencere yöneticisi ekler.
 */
import { BookOpen, ChevronLeft, ChevronRight, House, Link2, Minus, Plus, Search, SunMoon, X } from 'lucide-react';
import { localePaths, localizePath } from '../../lib/content/urls.ts';
import { languageHref, LANGUAGE_CODES, otherLocale, type Locale } from '../../lib/i18n/locales.ts';
import { useTranslations } from '../../lib/i18n/ui.ts';
import { sectionsFor, type IconName, type SectionId } from '../../lib/site/sections.ts';
import SectionIcon from '../icons/SectionIcon.tsx';

interface Props {
  locale: Locale;
  id: string;
  title: string;
  icon: IconName;
  variant: 'main' | 'intro';
  /** Kenar çubuğunda vurgulanacak bölüm. */
  section?: SectionId;
  /** Ana içerik penceresinde kırmızı düğme masaüstüne giden gerçek bir bağlantıdır. */
  closeHref?: string;
  /** Okuma modu ve bağlantı kopyalama düğmeleri. */
  readingTools?: boolean;
  /** Telefonda sol üstteki geri düğmesi. */
  backHref?: string;
  backLabel?: string;
  alternatePath?: string;
}

const { locale, id, title, icon, variant, section, closeHref, readingTools = false, backHref, backLabel, alternatePath } = Astro.props;
const t = useTranslations(locale);
const showSidebar = variant === 'main';
const pathname = Astro.url.pathname;
const sections = sectionsFor(locale);
const other = otherLocale(locale);
const otherPath = alternatePath ?? localizePath(pathname, other);
---

<div
  class:list={['window', `window--${variant}`, { 'window--no-sidebar': !showSidebar }]}
  data-window-id={id}
  data-window-title={title}
  data-window-icon={icon}
  data-window-main
  tabindex="-1"
>
  <div class="window__controls">
    {
      closeHref ? (
        <a class="traffic traffic--close" href={closeHref} data-window-action="close" aria-label={t.window.closeToDesktop}>
          <X aria-hidden="true" strokeWidth={3} />
        </a>
      ) : (
        <button type="button" class="traffic traffic--close" data-window-action="close" aria-label={t.window.close}>
          <X aria-hidden="true" strokeWidth={3} />
        </button>
      )
    }
    <button type="button" class="traffic traffic--minimize" data-window-action="minimize" aria-label={t.window.minimize}>
      <Minus aria-hidden="true" strokeWidth={3} />
    </button>
    <button type="button" class="traffic traffic--zoom" data-window-action="zoom" aria-label={t.window.zoom} aria-pressed="false">
      <Plus aria-hidden="true" strokeWidth={3} />
    </button>
  </div>

  {
    showSidebar && (
      <aside class="window__sidebar" aria-label={t.window.sidebar}>
        <div class="window__sidebar-head" data-window-handle />
        <nav class="sidebar-section" aria-label={t.window.favorites}>
          <p class="sidebar-heading">{t.window.favorites}</p>
          <ul class="sidebar-list">
            <li>
              <a class="sidebar-link" href={localePaths(locale).home} data-section-link>
                <House aria-hidden="true" />
                {t.sections.home.label}
              </a>
            </li>
            {sections.map((item) => (
              <li>
                <a
                  class="sidebar-link"
                  href={item.href}
                  data-section-link
                  aria-current={pathname === item.href ? 'page' : section === item.id ? 'true' : undefined}
                >
                  <SectionIcon name={item.icon} />
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <slot name="sidebar" />
      </aside>
    )
  }

  <div class="window__main">
    <div class="window__toolbar" data-window-handle>
      {
        backHref && (
          <a class="toolbar-back" href={backHref}>
            <ChevronLeft aria-hidden="true" />
            <span>{backLabel ?? t.window.back}</span>
          </a>
        )
      }
      <div class="toolbar-capsule toolbar-nav js-only">
        <button type="button" class="icon-button" data-window-action="back" aria-label={t.window.backLabel} title={t.window.back}>
          <ChevronLeft aria-hidden="true" />
        </button>
        <button type="button" class="icon-button" data-window-action="forward" aria-label={t.window.forwardLabel} title={t.window.forward}>
          <ChevronRight aria-hidden="true" />
        </button>
      </div>
      <p class="window__title">{title}</p>
      <div class="toolbar-spacer"></div>
      {
        readingTools && (
          <div class="toolbar-capsule js-only only-desktop">
            <button type="button" class="icon-button" data-window-action="reading" aria-pressed="false" aria-label={t.window.readingMode} title={t.window.readingMode}>
              <BookOpen aria-hidden="true" />
            </button>
            <button type="button" class="icon-button" data-copy-link aria-label={t.window.copyLink} title={t.window.copyLink}>
              <Link2 aria-hidden="true" />
            </button>
          </div>
        )
      }
      <div class="toolbar-capsule js-only only-compact">
        {
          readingTools && (
            <button type="button" class="icon-button" data-copy-link aria-label={t.window.copyLink}>
              <Link2 aria-hidden="true" />
            </button>
          )
        }
        {
          otherPath !== pathname && (
            <a class="icon-button lang-button" href={languageHref(otherPath, other)} hreflang={other} lang={other} data-lang-switch={other} aria-label={t.menubar.switchLanguage}>
              {LANGUAGE_CODES[other]}
            </a>
          )
        }
        <button type="button" class="icon-button" data-action="theme-toggle" aria-label={t.window.toggleTheme}>
          <SunMoon aria-hidden="true" />
        </button>
        <button type="button" class="icon-button" data-open-search aria-haspopup="dialog" aria-label={t.menubar.search}>
          <Search aria-hidden="true" />
        </button>
      </div>
      <button type="button" class="toolbar-search js-only only-desktop" data-open-search aria-haspopup="dialog" aria-label={t.menubar.search}>
        <Search aria-hidden="true" />
        <span>{t.window.search}</span>
        <kbd class="shortcut" aria-hidden="true"><span class="shortcut__mac">⌘</span><span class="shortcut__other">Ctrl</span>K</kbd>
      </button>
    </div>
    <main id="icerik" class="window__content" tabindex="-1">
      <div class="window__inner">
        <slot />
      </div>
    </main>
  </div>
  <div class="window__resize" data-window-resize aria-hidden="true"></div>
</div>

<style>
  .window__sidebar-head {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: var(--toolbar-h);
  }

  @media (min-width: 900px) {
    .only-compact {
      display: none !important;
    }
  }

  @media (max-width: 899.98px) {
    .only-desktop {
      display: none !important;
    }
  }
</style>
