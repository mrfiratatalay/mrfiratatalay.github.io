---
import { localePaths } from '../../lib/content/urls.ts';
import { initials, profile } from '../../lib/content/site-data.ts';
import { otherLocale, type Locale } from '../../lib/i18n/locales.ts';
import { useTranslations } from '../../lib/i18n/ui.ts';
import { sectionsFor, type SectionId } from '../../lib/site/sections.ts';
import AppIcon from '../icons/AppIcon.tsx';
import MenuBarStatus from './MenuBarStatus.tsx';

interface Props {
  locale: Locale;
  current: SectionId;
  pathname: string;
  /** Sayfanın diğer dildeki adresi (varsa). */
  alternatePath?: string | undefined;
}

const { locale, current, pathname, alternatePath } = Astro.props;
const t = useTranslations(locale);
---

<header class:list={['menubar', { 'menubar--launcher': current === 'home' }]}>
  <nav class="menubar__left" aria-label={t.menubar.mainMenu}>
    <a class="menubar__item menubar__brand" href={localePaths(locale).home} data-section-link aria-label={t.menubar.brand(profile.name)}>
      <AppIcon name="monogram" text={initials(profile.name)} className="menubar__logo" />
      <span>{profile.name}</span>
    </a>
    <ul class="menubar__menus">
      {
        sectionsFor(locale).map((section) => (
          <li>
            <a
              class="menubar__item"
              href={section.href}
              data-section-link
              aria-current={pathname === section.href ? 'page' : current === section.id ? 'true' : undefined}
            >
              {section.shortLabel}
            </a>
          </li>
        ))
      }
    </ul>
    <details class="desktop-window-menu js-only" data-window-menu>
      <summary class="menubar__item">{locale === 'tr' ? 'Pencere' : 'Window'}</summary>
      <div class="desktop-window-menu__panel glass glass-edge">
        <p class="desktop-window-menu__empty" data-window-menu-empty>{locale === 'tr' ? 'Açık pencere yok' : 'No open windows'}</p>
        <ul data-window-menu-list aria-label={locale === 'tr' ? 'Açık pencereler' : 'Open windows'}></ul>
      </div>
    </details>
  </nav>
  <MenuBarStatus client:load locale={locale} alternatePath={alternatePath} otherLocale={otherLocale(locale)} />
</header>
