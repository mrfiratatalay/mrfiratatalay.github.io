---
import { initials, profile } from '../../lib/content/site-data.ts';
import { SECTIONS, type SectionId } from '../../lib/site/sections.ts';
import AppIcon from '../icons/AppIcon.tsx';
import MenuBarStatus from './MenuBarStatus.tsx';

interface Props {
  current: SectionId;
  pathname: string;
}

const { current, pathname } = Astro.props;
---

<header class="menubar">
  <nav class="menubar__left" aria-label="Ana menü">
    <a class="menubar__item menubar__brand" href="/" data-section-link aria-label={`${profile.name} — masaüstüne dön`}>
      <AppIcon name="monogram" text={initials(profile.name)} className="menubar__logo" />
      <span>{profile.name}</span>
    </a>
    <ul class="menubar__menus">
      {
        SECTIONS.map((section) => (
          <li>
            <a
              class="menubar__item"
              href={section.href}
              data-section-link
              aria-current={pathname === section.href ? 'page' : current === section.id ? 'true' : undefined}
            >
              {section.shortLabel}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <MenuBarStatus client:load />
</header>
