---
/** Telefonda ana ekran: bölümler uygulama ikonları olarak görünür. */
import type { Locale } from '../../lib/i18n/locales.ts';
import { useTranslations } from '../../lib/i18n/ui.ts';
import { sectionsFor } from '../../lib/site/sections.ts';
import AppIcon from '../icons/AppIcon.tsx';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<nav class="home-apps" aria-label={t.home.apps}>
  <ul>
    {
      sectionsFor(locale).map((section) => (
        <li>
          <a class="home-app" href={section.href}>
            <AppIcon name={section.icon} />
            <span>{section.shortLabel}</span>
          </a>
        </li>
      ))
    }
    <li class="js-only">
      <button type="button" class="home-app" data-open-search aria-haspopup="dialog">
        <AppIcon name="search" />
        <span>{t.sections.search.short}</span>
      </button>
    </li>
  </ul>
</nav>

<style>
  .home-app {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
  }
</style>
