---
import { SECTIONS, type SectionId } from '../../lib/site/sections.ts';
import FolderIcon from '../icons/FolderIcon.astro';

interface Props {
  current: SectionId;
}

const { current } = Astro.props;
---

<nav class="desktop-icons" aria-label="Masaüstü klasörleri">
  <ul>
    {
      SECTIONS.map((section) => (
        <li>
          <a class="desktop-icon" href={section.href} data-section-link aria-current={current === section.id ? 'true' : undefined}>
            <FolderIcon icon={section.icon} />
            <span class="desktop-icon__label">{section.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>
