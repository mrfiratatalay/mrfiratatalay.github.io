---
/**
 * Kırmızı zeminde akan hız çizgileri (giriş ve kapanış). Her çizginin yeri, boyu ve hızı
 * sabittir; sayfa her açılışta aynı görünür.
 */
const streaks = [
  { y: 8, w: 34, h: 3, a: 0.3, t: 1.9, o: 0.1 },
  { y: 17, w: 22, h: 2, a: 0.22, t: 1.3, o: 0.6 },
  { y: 26, w: 46, h: 5, a: 0.16, t: 2.4, o: 0.35 },
  { y: 35, w: 28, h: 2, a: 0.34, t: 1.1, o: 0.8 },
  { y: 44, w: 38, h: 4, a: 0.2, t: 1.7, o: 0.2 },
  { y: 53, w: 24, h: 2, a: 0.3, t: 1.2, o: 0.5 },
  { y: 62, w: 50, h: 6, a: 0.13, t: 2.6, o: 0.75 },
  { y: 71, w: 30, h: 3, a: 0.26, t: 1.5, o: 0.05 },
  { y: 80, w: 40, h: 2, a: 0.3, t: 1.25, o: 0.45 },
  { y: 89, w: 26, h: 4, a: 0.18, t: 2.1, o: 0.9 },
];
---

<div class="rl-hero__streaks" aria-hidden="true">
  {streaks.map((s) => (
    <i style={`--y:${s.y};--w:${s.w};--h:${s.h};--a:${s.a};--t:${s.t};--o:${s.o}`} />
  ))}
</div>
