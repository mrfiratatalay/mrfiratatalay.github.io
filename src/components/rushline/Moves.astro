---
/** Üç hareket: eğ, bas, sıyır. Her birinin yanında hareketi gösteren küçük bir çizim var. */
import { landingCopy, type RushlineLanguage } from './landing-copy';

interface Props {
  lang: RushlineLanguage;
}

const { lang } = Astro.props;
const copy = landingCopy[lang];
const [tilt, hold, slip] = copy.how;
---

<section class="rl-section" aria-labelledby="rl-how">
  <div class="rl-wrap">
    <p class="rl-kicker" data-reveal>{copy.howKicker}</p>
    <h2 id="rl-how" class="rl-heading" data-reveal>{copy.howTitle}</h2>

    <ol class="rl-moves">
      <li class="rl-move" data-reveal style="--d:0">
        <svg class="rl-move__art" viewBox="0 0 160 120" aria-hidden="true" focusable="false">
          <path d="M26 44a62 62 0 0 1 14-18M134 44a62 62 0 0 0-14-18" fill="none" stroke="#ffd23a" stroke-width="4" stroke-linecap="round" />
          <path d="M22 34l4 11 10-5M138 34l-4 11-10-5" fill="none" stroke="#ffd23a" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
          <g class="rl-art-box rl-art-tilt">
            <rect x="54" y="12" width="52" height="98" rx="12" fill="#0c0708" stroke="#fff" stroke-width="4" />
            <path d="M80 22v78" stroke="rgb(255 255 255 / .35)" stroke-width="3" stroke-dasharray="9 8" />
            <g class="rl-art-box rl-art-lean">
              <rect x="75" y="64" width="10" height="24" rx="5" fill="#e30212" stroke="#fff" stroke-width="2" />
            </g>
          </g>
        </svg>
        <h3>{tilt[0]}</h3>
        <p>{tilt[1]}</p>
      </li>

      <li class="rl-move" data-reveal style="--d:1">
        <svg class="rl-move__art" viewBox="0 0 160 120" aria-hidden="true" focusable="false">
          <text x="14" y="30" font-size="15" font-style="italic" font-weight="900" fill="#fff" letter-spacing="1.5">BOOST</text>
          <g transform="skewX(-18)">
            {[0, 1, 2, 3, 4].map((i) => (
              <rect class="rl-art-seg" style={`--i:${i}`} x={32 + i * 21} y="42" width="16" height="16" fill={['#35d6ff', '#7fe08a', '#ffe14a', '#ff9a3c', '#ff2d2d'][i]} />
            ))}
          </g>
          <g class="rl-art-box rl-art-x5">
            <text x="118" y="62" font-size="34" font-style="italic" font-weight="900" fill="#ffd23a" stroke="#0c0708" stroke-width="5" paint-order="stroke">x5</text>
          </g>
          <g class="rl-art-box rl-art-finger">
            <circle cx="46" cy="92" r="17" fill="none" stroke="rgb(255 255 255 / .35)" stroke-width="3" />
            <circle cx="46" cy="92" r="9" fill="#fff" />
          </g>
        </svg>
        <h3>{hold[0]}</h3>
        <p>{hold[1]}</p>
      </li>

      <li class="rl-move" data-reveal style="--d:2">
        <svg class="rl-move__art" viewBox="0 0 160 120" aria-hidden="true" focusable="false">
          <clipPath id="rl-road"><rect x="30" y="4" width="84" height="112" rx="12" /></clipPath>
          <rect x="30" y="4" width="84" height="112" rx="12" fill="#1b1416" stroke="rgb(255 255 255 / .25)" stroke-width="2" />
          <g clip-path="url(#rl-road)">
            <path class="rl-art-lane" d="M72 -20v170" stroke="rgb(255 255 255 / .5)" stroke-width="3" stroke-dasharray="12 12" />
            <g class="rl-art-car">
              <rect x="44" y="0" width="20" height="38" rx="6" fill="#2f6bff" stroke="#fff" stroke-width="2" />
              <rect x="48" y="8" width="12" height="10" rx="2" fill="#0c1a44" />
            </g>
            <rect x="80" y="62" width="10" height="26" rx="5" fill="#e30212" stroke="#fff" stroke-width="2" />
            <path d="M82 92l-2 10M88 92l2 10" stroke="#ffd23a" stroke-width="3" stroke-linecap="round" />
          </g>
          <g class="rl-art-box rl-art-pop">
            <text x="118" y="58" font-size="20" font-style="italic" font-weight="900" fill="#ffd23a" stroke="#0c0708" stroke-width="4" paint-order="stroke">+50</text>
          </g>
        </svg>
        <h3>{slip[0]}</h3>
        <p>{slip[1]}</p>
      </li>
    </ol>
  </div>
</section>
