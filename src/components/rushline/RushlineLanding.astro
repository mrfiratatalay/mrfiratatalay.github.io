---
/**
 * Rushline ürün sayfası.
 *
 * Sayfa oyunun kendisi gibi görünür: kapağın kırmızısıyla başlar, asfalt siyahında devam
 * eder, yine kırmızıda biter. Yazılar oyunun kalın eğik yazısıdır. Harita, mod ve motor
 * görselleri oyunun kendi çizimleridir; ekran görüntüleri ve video oyunun simülatörde
 * çekilmiş hâlidir (`public/rushline/images/`). Etkileşimli bölümler (haritalar, garaj)
 * radyo düğmeleriyle çalışır; betik yalnızca süsler içindir.
 */
import AppStoreBadge from './AppStoreBadge.astro';
import Gallery from './Gallery.astro';
import Garage from './Garage.astro';
import Hero from './Hero.astro';
import Maps from './Maps.astro';
import Modes from './Modes.astro';
import Moves from './Moves.astro';
import Speedo from './Speedo.astro';
import Streaks from './Streaks.astro';
import { landingCopy, type RushlineLanguage } from './landing-copy';
import { helpPath } from '../../lib/rushline/help-links';
import './landing.css';
import './hero.css';
import './maps.css';
import './garage.css';
import './sections.css';

interface Props {
  lang: RushlineLanguage;
}

const { lang } = Astro.props;
const copy = landingCopy[lang];
const other: RushlineLanguage = lang === 'tr' ? 'en' : 'tr';
const img = '/rushline/images/';
const canonical = new URL(copy.path, Astro.site ?? Astro.url);
const alternate = new URL(copy.alternate, canonical);
const socialImage = new URL(img + 'social.jpg', canonical);
const portfolio = lang === 'tr' ? '/oyunlar/' : '/en/games/';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#e30212" />
    <title>{copy.title}</title>
    <meta name="description" content={copy.description} />
    <meta property="og:title" content={copy.title} />
    <meta property="og:description" content={copy.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={socialImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={copy.heroAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang={lang} href={canonical.href} />
    <link rel="alternate" hreflang={other} href={alternate.href} />
    <link rel="icon" href={img + 'app-icon.webp'} type="image/webp" />
    <link rel="apple-touch-icon" href={img + 'apple-touch-icon.png'} />
    <link rel="preload" href={img + 'hero.webp'} as="image" type="image/webp" />
    <script is:inline>document.documentElement.classList.add('rl-js');</script>
  </head>
  <body class="rushline">
    <a class="rl-skip" href="#content">{copy.skip}</a>

    <header class="rl-top">
      <a class="rl-brand" href={copy.path}>
        <img src={img + 'app-icon.webp'} width="40" height="40" alt="" />
        <span>RUSHLINE</span>
      </a>
      <nav class="rl-top__links" aria-label="Rushline">
        <a href={portfolio}>{copy.portfolio}</a>
        <a href={copy.alternate} hreflang={other} lang={other}>{copy.languageName}</a>
      </nav>
    </header>

    <Hero lang={lang} />

    <main id="content">
      <Moves lang={lang} />
      <Maps lang={lang} />
      <Modes lang={lang} />
      <Garage lang={lang} />
      <Gallery lang={lang} />
    </main>

    <footer>
      <div class="rl-closing">
        <Streaks />
        <img class="rl-closing__icon" src={img + 'app-icon.webp'} width="132" height="132" alt="" loading="lazy" />
        <p class="rl-kicker">{copy.closingKicker}</p>
        <h2 class="rl-logo">{copy.closingTitle}</h2>
        <p class="rl-closing__text">{copy.closingText}</p>
        <AppStoreBadge label={copy.soon} />
        <p class="rl-note">{copy.soonNote}</p>
      </div>
      <div class="rl-foot">
        <p>{copy.madeBy}</p>
        <nav aria-label={copy.support}>
          <a href={helpPath(lang, 'support')}>{copy.support}</a>
          <a href={helpPath(lang, 'privacy')}>{copy.privacy}</a>
          <a href={portfolio}>{copy.portfolio}</a>
        </nav>
      </div>
    </footer>

    <Speedo />

    <script>
      const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Hareketi azaltmak isteyenlerde video kendi kendine oynamaz; poster görünür kalır.
      const video = document.querySelector<HTMLVideoElement>('[data-rl-video]');
      if (video && calm) {
        video.removeAttribute('autoplay');
        video.pause();
        video.controls = true;
      }

      // Sayfa aşağı indikçe parçalar belirir (betik çalışmazsa hepsi baştan görünür).
      const pieces = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const watcher = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-in');
            watcher.unobserve(entry.target);
          }
        }, { rootMargin: '0px 0px -6% 0px', threshold: 0.08 });
        pieces.forEach((piece) => watcher.observe(piece));
      } else {
        pieces.forEach((piece) => piece.classList.add('is-in'));
      }

      // Fareyle gezen için harita dilimi üstüne gelince açılır; dokunmada ve klavyede seçimle.
      if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
        document.querySelectorAll<HTMLLabelElement>('[data-rl-maps] .rl-map').forEach((slice) => {
          slice.addEventListener('mouseenter', () => {
            const choice = slice.querySelector('input');
            if (choice) choice.checked = true;
          });
        });
      }

      // Yana kayan şeritler klavyeyle de kaydırılabilsin diye odaklanabilir olur.
      const strips = document.querySelectorAll<HTMLElement>('[data-strip]');
      const markStrips = () => strips.forEach((strip) => {
        if (strip.scrollWidth > strip.clientWidth + 1) strip.tabIndex = 0;
        else strip.removeAttribute('tabindex');
      });
      markStrips();
      addEventListener('resize', markStrips, { passive: true });

      // Hız göstergesi: kaydırma hızı ibreyi kaldırır, durunca ibre yavaşça iner.
      const speedo = document.querySelector<HTMLElement>('[data-rl-speedo]');
      if (speedo && !calm) {
        const needle = speedo.querySelector<SVGElement>('[data-needle]')!;
        const speedText = speedo.querySelector('[data-speed]')!;
        const gearText = speedo.querySelector('[data-gear]')!;
        const ticks = [...speedo.querySelectorAll('[data-tick]')];
        const top = 325;
        let lastY = scrollY;
        let lastTime = 0;
        let speed = 0;
        let idle = 0;
        let running = false;

        const draw = () => {
          const share = speed / top;
          needle.style.transform = `rotate(${-90 + share * 180}deg)`;
          speedText.textContent = String(Math.round(speed));
          gearText.textContent = String(Math.min(6, 1 + Math.floor(share * 6)));
          ticks.forEach((tick, index) => tick.classList.toggle('is-on', index / (ticks.length - 1) <= share && speed > 1));
        };

        const frame = (time: number) => {
          const elapsed = Math.max(8, time - lastTime);
          const target = Math.min(top, (Math.abs(scrollY - lastY) / elapsed) * 105);
          lastY = scrollY;
          lastTime = time;
          speed += (target - speed) * (target > speed ? 0.16 : 0.035);
          idle = speed < 2 && target < 1 ? idle + 1 : 0;
          if (idle > 36) {
            speed = 0;
            running = false;
            speedo.classList.remove('is-live');
            draw();
            return;
          }
          draw();
          requestAnimationFrame(frame);
        };

        // Alt bilgi görünürken gösterge çekilir; bağlantıların üstünü kapatmaz.
        const foot = document.querySelector('.rl-foot');
        if (foot && 'IntersectionObserver' in window) {
          new IntersectionObserver(([entry]) => speedo.classList.toggle('is-parked', entry.isIntersecting)).observe(foot);
        }

        addEventListener('scroll', () => {
          if (running) return;
          running = true;
          idle = 0;
          lastY = scrollY;
          lastTime = performance.now();
          speedo.classList.add('is-live');
          requestAnimationFrame(frame);
        }, { passive: true });
      }
    </script>
  </body>
</html>
