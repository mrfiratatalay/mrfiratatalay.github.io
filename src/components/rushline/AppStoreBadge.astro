---
/**
 * "Yakında App Store'da" rozeti. Apple'ın resmî indirme rozeti ancak oyun yayındayken
 * kullanılabilir; o gün bu rozet gerçek bağlantıyla değiştirilecek. Tıklanmadığı için
 * düğme değil, yanıp sönen ışıklı bir damga gibi durur (ışık landing.css'tedir).
 */
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<p class="rl-badge"><span>{label}</span></p>
