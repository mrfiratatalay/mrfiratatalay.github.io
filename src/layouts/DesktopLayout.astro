---
/**
 * Bütün sayfalarda ortak Mac çerçevesi: menü çubuğu, masaüstü klasörleri,
 * pencere(ler) ve dock. Sayfa içeriği ilk HTML yanıtında hazır gelir.
 */
import '../styles/index.css';
import BaseHead, { type SeoProps } from '../components/BaseHead.astro';
import DesktopIcons from '../components/desktop/DesktopIcons.astro';
import Dock, { type DockItem } from '../components/desktop/Dock.tsx';
import MenuBar from '../components/desktop/MenuBar.astro';
import SearchDialog from '../components/search/SearchDialog.tsx';
import { localizePath } from '../lib/content/urls.ts';
import { otherLocale, type Locale } from '../lib/i18n/locales.ts';
import { useTranslations } from '../lib/i18n/ui.ts';
import { homeSection, sectionsFor, type SectionId } from '../lib/site/sections.ts';

type Props = SeoProps & {
  locale: Locale;
  section: SectionId;
  /** Ana sayfa (masaüstü). */
  home?: boolean;
  /** Diğer dildeki karşılık; verilmezse adresten hesaplanır. */
  alternatePath?: string;
};

const { locale, section, home = false, alternatePath, ...seo } = Astro.props;
const t = useTranslations(locale);
const pathname = Astro.url.pathname;
const other = otherLocale(locale);
const otherPath = alternatePath ?? localizePath(pathname, other);
const alternates: Partial<Record<Locale, string>> =
  otherPath !== pathname ? { [locale]: pathname, [other]: otherPath } : { [locale]: pathname };
const desktop = homeSection(locale);
const dockItems: DockItem[] = [
  { id: desktop.id, label: desktop.label, href: desktop.href, icon: desktop.icon, desktopOnly: true },
  ...sectionsFor(locale).map((item) => ({ id: item.id, label: item.shortLabel, href: item.href, icon: item.icon })),
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <BaseHead {...seo} locale={locale} alternates={alternates} isHome={home} />
    <script is:inline>
      // Sayfa çizilmeden önce: dil, tema, okuma boyutu, bildirim, okuma modu ve pencere konumu.
      (() => {
        const root = document.documentElement;
        const pageLang = root.lang === 'en' ? 'en' : 'tr';
        const valid = (value) => value === 'tr' || value === 'en';

        // Dil: kayıtlı tercih (veya ?dil=) varsa o, yoksa cihazın dili. Arama motoru
        // botları yönlendirilmez; her dilin sayfası kendi adresinde dizine girer.
        let saved = null;
        try {
          const params = new URLSearchParams(location.search);
          const forced = params.get('dil');
          if (valid(forced)) {
            saved = forced;
            let stored = false;
            try {
              localStorage.setItem('dil', forced);
              stored = true;
            } catch (error) {
              try {
                sessionStorage.setItem('dil', forced);
                stored = true;
              } catch (ignored) {}
            }
            root.toggleAttribute('data-lang-transient', !stored);
            if (stored) {
              params.delete('dil');
              const query = params.toString();
              history.replaceState(history.state, '', location.pathname + (query ? '?' + query : '') + location.hash);
            }
          } else {
            try {
              saved = localStorage.getItem('dil');
            } catch (error) {}
            if (!valid(saved)) {
              try {
                saved = sessionStorage.getItem('dil');
              } catch (error) {}
            }
          }
        } catch (error) {}
        if (!valid(saved)) saved = null;
        root.dataset.langPref = saved || 'auto';
        let wanted = saved;
        if (!wanted) {
          const list = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ''];
          wanted = 'en';
          for (const item of list) {
            const code = String(item).slice(0, 2).toLowerCase();
            if (valid(code)) {
              wanted = code;
              break;
            }
          }
        }
        const bot = /bot|crawl|spider|slurp|lighthouse|headless|preview|facebookexternalhit|embedly/i.test(navigator.userAgent);
        if (wanted !== pageLang && !bot) {
          const link = document.querySelector('link[rel="alternate"][hreflang="' + wanted + '"]');
          if (link) {
            root.style.visibility = 'hidden';
            location.replace(new URL(link.href).pathname + location.search + location.hash);
            return;
          }
        }

        root.classList.add('js');
        if (/Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent)) root.setAttribute('data-mac', '');
        let theme = null;
        try {
          theme = localStorage.getItem('tema');
          const scale = Number(localStorage.getItem('okuma-boyutu'));
          if (scale >= 0.9 && scale <= 1.3) root.style.setProperty('--reading-scale', String(scale));
          if (localStorage.getItem('bildirim-kapatildi') || sessionStorage.getItem('bildirim-kapatildi')) {
            root.setAttribute('data-hint-dismissed', '');
          }
        } catch (error) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        root.dataset.theme = theme;
        for (const meta of document.querySelectorAll('meta[name="theme-color"]')) {
          meta.setAttribute('content', theme === 'dark' ? '#292a2c' : '#d3ccc1');
        }
        try {
          if (document.referrer && new URL(document.referrer).origin === location.origin) {
            root.setAttribute('data-navigated', '');
          }
        } catch (error) {}
        try {
          if (sessionStorage.getItem('okuma-modu') === '1') root.setAttribute('data-reading', '');
          if (!matchMedia('(min-width: 900px)').matches) return;
          const areaWidth = innerWidth;
          const areaHeight = innerHeight - 34 - 100;
          for (const id of ['main', 'intro']) {
            const raw = sessionStorage.getItem('pencere:' + id);
            if (!raw) continue;
            const g = JSON.parse(raw);
            if (![g.x, g.y, g.width, g.height].every(Number.isFinite)) continue;
            if (g.maximized) root.setAttribute('data-' + id + '-maximized', '');
            const w = Math.min(g.width, areaWidth);
            const h = Math.min(g.height, areaHeight);
            const x = Math.min(Math.max(g.x, 0), Math.max(0, areaWidth - 120));
            const y = Math.min(Math.max(g.y, 0), Math.max(0, areaHeight - 58));
            root.style.setProperty('--' + id + '-x', x + 'px');
            root.style.setProperty('--' + id + '-y', y + 'px');
            root.style.setProperty('--' + id + '-w', w + 'px');
            root.style.setProperty('--' + id + '-h', h + 'px');
          }
        } catch (error) {}
      })();
    </script>
  </head>
  <body data-section={section}>
    <a class:list={['skip-link', { 'skip-link--desktop': home }]} href="#icerik">{t.site.skipToContent}</a>
    {home && <a class="skip-link skip-link--mobile" href="#mobile-icerik">{t.site.skipToContent}</a>}
    <div class="desktop">
      <MenuBar locale={locale} current={section} pathname={pathname} alternatePath={alternates[other]} />
      <div class="workspace" data-workspace>
        <DesktopIcons locale={locale} current={section} />
        <slot />
      </div>
      <div class="dock-bar">
        <Dock client:load locale={locale} items={dockItems} current={section} pathname={pathname} />
      </div>
    </div>
    <SearchDialog client:load locale={locale} />
    <script>
      import { initLanguage } from '../lib/i18n/client.ts';
      import { watchSystemTheme } from '../lib/ui/appearance.ts';
      import { initReadingEnhancements } from '../lib/ui/enhancements.ts';
      import { initDesktop } from '../lib/window-manager/controller.ts';

      initLanguage();
      initDesktop();
      initReadingEnhancements();
      watchSystemTheme();
    </script>
  </body>
</html>
