---
/**
 * Okuma penceresi: makale, not ve proje sayfaları. Pencere doğrudan açık gelir;
 * Google'dan gelen ziyaretçi masaüstünde klasör aramadan yazıyı görür.
 */
import type { MarkdownHeading } from 'astro';
import type { SeoProps } from '../components/BaseHead.astro';
import Toc from '../components/content/Toc.astro';
import Window from '../components/desktop/Window.astro';
import { localePaths } from '../lib/content/urls.ts';
import { hasToc } from '../lib/content/toc.ts';
import type { Locale } from '../lib/i18n/locales.ts';
import type { IconName, SectionId } from '../lib/site/sections.ts';
import DesktopLayout from './DesktopLayout.astro';

type Props = SeoProps & {
  locale: Locale;
  section: SectionId;
  windowTitle: string;
  icon: IconName;
  backHref: string;
  backLabel: string;
  headings?: MarkdownHeading[];
};

const { locale, section, windowTitle, icon, backHref, backLabel, headings = [], ...seo } = Astro.props;
---

<DesktopLayout {...seo} locale={locale} section={section}>
  <Window
    locale={locale}
    id="main"
    variant="main"
    title={windowTitle}
    icon={icon}
    section={section}
    closeHref={localePaths(locale).home}
    readingTools
    backHref={backHref}
    backLabel={backLabel}
  >
    {hasToc(headings) && <Toc slot="sidebar" locale={locale} headings={headings} variant="sidebar" />}
    <slot />
  </Window>
</DesktopLayout>
