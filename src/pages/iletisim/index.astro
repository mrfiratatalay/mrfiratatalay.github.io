---
import { ChevronRight, Mail, MapPin } from 'lucide-react';
import Window from '../../components/desktop/Window.astro';
import AppIcon from '../../components/icons/AppIcon.tsx';
import LinkIcon from '../../components/icons/LinkIcon.tsx';
import DesktopLayout from '../../layouts/DesktopLayout.astro';
import { profile } from '../../lib/content/site-data.ts';
---

<DesktopLayout title="İletişim" description={`${profile.name} ile iletişim: e-posta ve sosyal bağlantılar.`} section="contact">
  <Window id="main" variant="main" title="İletişim" icon="contact" section="contact" closeHref="/" backHref="/" backLabel="Masaüstü">
    <div class="article">
      <header class="page-head">
        <p class="page-head__eyebrow"><AppIcon name="contact" /> İletişim</p>
        <h1 class="page-title">Merhaba de</h1>
        <p class="page-lead">İş, freelance veya işbirliği için bana e-postayla ulaşabilir ya da aşağıdaki hesaplardan yazabilirsin.</p>
      </header>

      {
        profile.email ? (
          <ul class="group">
            <li>
              <a class="group__row" href={`mailto:${profile.email}`}>
                <span class="app-icon app-icon--contact" aria-hidden="true">
                  <Mail />
                </span>
                <span class="group__text">
                  <span class="group__title">E-posta gönder</span>
                  <span class="group__subtitle">{profile.email}</span>
                </span>
                <ChevronRight className="group__chevron" aria-hidden="true" />
              </a>
            </li>
          </ul>
        ) : (
          <p class="empty-state">E-posta adresi henüz eklenmedi.</p>
        )
      }

      {
        profile.links.length > 0 && (
          <section aria-labelledby="hesaplar">
            <h2 class="section-title" id="hesaplar">
              Hesaplar
            </h2>
            <ul class="group">
              {profile.links.map((link) => (
                <li>
                  <a class="group__row" href={link.url} rel="me noopener">
                    <span class={`app-icon app-icon--link-${link.kind}`} aria-hidden="true">
                      <LinkIcon kind={link.kind} />
                    </span>
                    <span class="group__text">
                      <span class="group__title">{link.label}</span>
                      <span class="group__subtitle">{link.url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</span>
                    </span>
                    <ChevronRight className="group__chevron" aria-hidden="true" />
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        profile.location && (
          <p class="profile-card__location" style="margin-top: 26px;">
            <MapPin aria-hidden="true" />
            {profile.location}
          </p>
        )
      }
    </div>
  </Window>
</DesktopLayout>
