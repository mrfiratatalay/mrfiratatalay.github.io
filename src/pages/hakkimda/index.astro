---
import { Download, GraduationCap, Languages, Mail, MapPin, Sparkles } from 'lucide-react';
import Window from '../../components/desktop/Window.astro';
import LinkIcon from '../../components/icons/LinkIcon.tsx';
import DesktopLayout from '../../layouts/DesktopLayout.astro';
import { initials, profile } from '../../lib/content/site-data.ts';
import { paths } from '../../lib/content/urls.ts';

const site = Astro.site ?? new URL('https://mrfiratatalay.github.io');
const paragraphs = profile.bio.split(/\n\s*\n/).map((text) => text.trim()).filter(Boolean);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: new URL(paths.about, site).toString(),
  inLanguage: 'tr-TR',
  mainEntity: {
    '@type': 'Person',
    name: profile.name,
    jobTitle: profile.title,
    description: profile.shortBio,
    ...(profile.avatar ? { image: new URL(profile.avatar, site).toString() } : {}),
    sameAs: profile.links.map((link) => link.url),
  },
};
---

<DesktopLayout
  title="Hakkımda"
  description={`${profile.name}: ${profile.shortBio}`}
  section="about"
  type="profile"
  image={profile.avatar}
  imageAlt={profile.avatarAlt}
  jsonLd={jsonLd}
>
  <Window id="main" variant="main" title="Hakkımda" icon="about" section="about" closeHref="/" backHref="/" backLabel="Masaüstü">
    <div class="article">
      <div class="profile-card">
        {
          profile.avatar ? (
            <img class="avatar-xl" src={profile.avatar} alt={profile.avatarAlt ?? ''} width="128" height="128" />
          ) : (
            <span class="avatar-xl avatar-initials" aria-hidden="true">
              {initials(profile.name)}
            </span>
          )
        }
        <h1 class="profile-card__name">{profile.name}</h1>
        <p class="profile-card__title">{profile.title}</p>
        {
          profile.location && (
            <p class="profile-card__location">
              <MapPin aria-hidden="true" />
              {profile.location}
            </p>
          )
        }
        <ul class="quick-actions" aria-label="Hızlı bağlantılar">
          {
            profile.email && (
              <li>
                <a class="quick-action quick-action--primary" href={`mailto:${profile.email}`}>
                  <span class="quick-action__icon">
                    <Mail aria-hidden="true" />
                  </span>
                  E-posta
                </a>
              </li>
            )
          }
          {
            profile.links.map((link) => (
              <li>
                <a class="quick-action" href={link.url} rel="me noopener">
                  <span class="quick-action__icon">
                    <LinkIcon kind={link.kind} />
                  </span>
                  {link.label}
                </a>
              </li>
            ))
          }
          {
            profile.cv && (
              <li>
                <a class="quick-action" href={profile.cv} download>
                  <span class="quick-action__icon">
                    <Download aria-hidden="true" />
                  </span>
                  CV
                </a>
              </li>
            )
          }
        </ul>
      </div>

      <div class="bio">
        {paragraphs.map((text) => <p>{text}</p>)}
      </div>

      {
        profile.experience.length > 0 && (
          <section aria-labelledby="deneyim">
            <h2 class="section-title" id="deneyim">
              Deneyim
            </h2>
            <ol class="group timeline">
              {profile.experience.map((item) => (
                <li>
                  <h3>
                    {item.role} <span class="org">· {item.organization}</span>
                  </h3>
                  {item.period && <span class="period">{item.period}</span>}
                  {item.description && <p>{item.description}</p>}
                </li>
              ))}
            </ol>
          </section>
        )
      }

      {
        (profile.education.length > 0 || profile.languages.length > 0) && (
          <section aria-labelledby="egitim">
            <h2 class="section-title" id="egitim">
              Eğitim ve diller
            </h2>
            <dl class="facts">
              {profile.education.map((item) => (
                <div>
                  <dt>
                    <GraduationCap aria-hidden="true" /> Eğitim
                  </dt>
                  <dd>
                    <strong>{item.school}</strong>
                    {item.program && <br />}
                    {item.program}
                    {item.period && <span class="muted"> · {item.period}</span>}
                  </dd>
                </div>
              ))}
              {profile.languages.length > 0 && (
                <div>
                  <dt>
                    <Languages aria-hidden="true" /> Diller
                  </dt>
                  <dd>{profile.languages.join(', ')}</dd>
                </div>
              )}
            </dl>
          </section>
        )
      }

      {
        profile.skills.length > 0 && (
          <section aria-labelledby="yetenekler">
            <h2 class="section-title" id="yetenekler">
              Yetenekler
            </h2>
            <div class="facts">
              {profile.skills.map((group) => (
                <div class="skill-group" style="padding: 16px 18px; border-radius: 18px; background: var(--card-bg); box-shadow: var(--shadow-card);">
                  <h3 style="display: flex; align-items: center; gap: 7px;">
                    <Sparkles aria-hidden="true" size={14} color="var(--accent)" />
                    {group.group}
                  </h3>
                  <ul class="chip-list">
                    {group.items.map((skill) => (
                      <li class="chip">{skill}</li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </section>
        )
      }
    </div>
  </Window>
</DesktopLayout>
