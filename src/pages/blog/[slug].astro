---
import { render } from 'astro:content';
import Breadcrumbs from '../../components/content/Breadcrumbs.astro';
import Byline from '../../components/content/Byline.astro';
import Pager from '../../components/content/Pager.astro';
import SeriesBanner from '../../components/content/SeriesBanner.astro';
import Toc from '../../components/content/Toc.astro';
import ReadingLayout from '../../layouts/ReadingLayout.astro';
import { findSeriesContext, getPublishedPosts, type BlogPost } from '../../lib/content/collections.ts';
import { publicImageSize } from '../../lib/content/images.ts';
import { readingMinutes } from '../../lib/content/rules.ts';
import { categoryLabel, profile } from '../../lib/content/site-data.ts';
import { paths } from '../../lib/content/urls.ts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.data.urlSlug }, props: { post } }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { data } = post;
const { Content, headings } = await render(post);
const url = paths.blogPost(data.urlSlug);
const site = Astro.site ?? new URL('https://mrfiratatalay.github.io');
const series = await findSeriesContext(url);
const related = series
  ? []
  : (await getPublishedPosts()).filter((other) => other.id !== post.id && other.data.category === data.category).slice(0, 2);
const coverSize = await publicImageSize(data.cover);
const label = categoryLabel(data.category);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.description,
  datePublished: data.publishedAt.toISOString(),
  ...(data.updatedAt ? { dateModified: data.updatedAt.toISOString() } : {}),
  ...(data.cover ? { image: new URL(data.cover, site).toString() } : {}),
  author: { '@type': 'Person', name: profile.name, url: new URL(paths.about, site).toString() },
  mainEntityOfPage: new URL(url, site).toString(),
  inLanguage: 'tr-TR',
  ...(data.tags.length ? { keywords: data.tags.join(', ') } : {}),
};
---

<ReadingLayout
  title={data.title}
  description={data.description ?? ''}
  section="blog"
  windowTitle="Blog"
  icon="blog"
  backHref={paths.blog}
  backLabel="Blog"
  headings={headings}
  type="article"
  publishedTime={data.publishedAt}
  modifiedTime={data.updatedAt}
  tags={data.tags}
  image={data.cover}
  imageAlt={data.coverAlt}
  jsonLd={jsonLd}
>
  <article class="article" data-pagefind-body data-pagefind-meta="type:Makale">
    <Breadcrumbs items={[{ label: 'Blog', href: paths.blog }, { label: data.title }]} />
    {series && <SeriesBanner context={series} />}
    <header class="article-header">
      <p class="article-kicker" data-pagefind-ignore>
        {label && <a class="pill" href={`${paths.blog}?kategori=${data.category}`}>{label}</a>}
        <span>Makale</span>
      </p>
      <h1 class="article-title">{data.title}</h1>
      {data.description && <p class="article-lead">{data.description}</p>}
      <Byline publishedAt={data.publishedAt} updatedAt={data.updatedAt} minutes={readingMinutes(post.body ?? '')} />
    </header>
    {
      data.cover && (
        <figure class="article-cover">
          <img src={data.cover} alt={data.coverAlt ?? ''} width={coverSize?.width} height={coverSize?.height} />
        </figure>
      )
    }
    <Toc headings={headings} variant="inline" />
    <div class="prose">
      <Content />
    </div>
    {
      series ? (
        <Pager heading={`${series.series.title} serisi`} previous={series.previous} next={series.next} previousLabel="Önceki part" nextLabel="Sonraki part" />
      ) : (
        <Pager
          heading="İlgili yazılar"
          previous={related[0] ? { title: related[0].data.title, url: paths.blogPost(related[0].data.urlSlug) } : undefined}
          next={related[1] ? { title: related[1].data.title, url: paths.blogPost(related[1].data.urlSlug) } : undefined}
          previousLabel="Okuyabilirsin"
          nextLabel="Bu da ilgini çekebilir"
        />
      )
    }
  </article>
</ReadingLayout>
