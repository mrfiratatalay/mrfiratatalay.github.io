---
import { Rss, Tag } from 'lucide-react';
import PostCard from '../../components/content/PostCard.astro';
import Window from '../../components/desktop/Window.astro';
import AppIcon from '../../components/icons/AppIcon.tsx';
import DesktopLayout from '../../layouts/DesktopLayout.astro';
import { getPublishedPosts } from '../../lib/content/collections.ts';
import { taxonomy } from '../../lib/content/site-data.ts';
import { paths } from '../../lib/content/urls.ts';

const posts = await getPublishedPosts();
const categories = taxonomy.categories
  .map((category) => ({ ...category, count: posts.filter((post) => post.data.category === category.id).length }))
  .filter((category) => category.count > 0);
---

<DesktopLayout title="Blog" description="Makaleler: öğrendiklerim, denediklerim ve yazılım üzerine notlar." section="blog">
  <Window id="main" variant="main" title="Blog" icon="blog" section="blog" closeHref="/" backHref="/" backLabel="Masaüstü">
    <Fragment slot="sidebar">
      <nav class="sidebar-section" aria-label="Kategoriler">
        <p class="sidebar-heading">Kategoriler</p>
        <ul class="sidebar-list">
          <li>
            <a class="sidebar-link" href={paths.blog} data-category-filter="" aria-current="page">
              <Tag aria-hidden="true" />
              Tüm yazılar <span class="count">{posts.length}</span>
            </a>
          </li>
          {
            categories.map((category) => (
              <li>
                <a class="sidebar-link" href={`${paths.blog}?kategori=${category.id}`} data-category-filter={category.id}>
                  <Tag aria-hidden="true" />
                  {category.label} <span class="count">{category.count}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <nav class="sidebar-section" aria-label="Takip et">
        <p class="sidebar-heading">Takip et</p>
        <ul class="sidebar-list">
          <li>
            <a class="sidebar-link" href={paths.rss}>
              <Rss aria-hidden="true" />
              RSS akışı
            </a>
          </li>
        </ul>
      </nav>
    </Fragment>

    <header class="page-head">
      <p class="page-head__eyebrow"><AppIcon name="blog" /> Blog</p>
      <h1 class="page-title">Yazılar</h1>
      <p class="page-lead">Öğrendiklerimi, denediklerimi ve projelerimden çıkan dersleri burada yazıyorum.</p>
    </header>

    {
      categories.length > 1 && (
        <ul class="filter-bar filter-bar--compact" aria-label="Kategori filtresi">
          <li>
            <a href={paths.blog} data-category-filter="" aria-pressed="true">
              Tümü
            </a>
          </li>
          {categories.map((category) => (
            <li>
              <a href={`${paths.blog}?kategori=${category.id}`} data-category-filter={category.id} aria-pressed="false">
                {category.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }

    {
      posts.length === 0 ? (
        <p class="empty-state">Henüz yayınlanmış yazı yok.</p>
      ) : (
        <ul class="card-grid" data-post-list>
          {posts.map((post, index) => (
            <li data-category={post.data.category} class:list={{ 'card-grid__wide': index === 0 }}>
              <PostCard post={post} featured={index === 0} />
            </li>
          ))}
        </ul>
      )
    }
    <p class="empty-state" data-filter-empty hidden>Bu kategoride henüz yazı yok.</p>
  </Window>
</DesktopLayout>

<script>
  // Kategori filtresi: JavaScript kapalıyken bütün yazılar listelenir.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-category-filter]')];
  const items = [...document.querySelectorAll<HTMLElement>('[data-post-list] > [data-category]')];
  const empty = document.querySelector<HTMLElement>('[data-filter-empty]');

  function apply(category: string) {
    let visible = 0;
    for (const item of items) {
      const show = !category || item.dataset.category === category;
      item.hidden = !show;
      if (show) visible += 1;
    }
    if (empty) empty.hidden = visible > 0;
    for (const link of links) {
      const active = (link.dataset.categoryFilter ?? '') === category;
      if (link.closest('.filter-bar')) link.setAttribute('aria-pressed', String(active));
      else if (active) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    }
  }

  for (const link of links) {
    link.addEventListener('click', (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey) return;
      event.preventDefault();
      const category = link.dataset.categoryFilter ?? '';
      const url = new URL(window.location.href);
      if (category) url.searchParams.set('kategori', category);
      else url.searchParams.delete('kategori');
      window.history.replaceState(null, '', url);
      apply(category);
    });
  }

  apply(new URLSearchParams(window.location.search).get('kategori') ?? '');
</script>
