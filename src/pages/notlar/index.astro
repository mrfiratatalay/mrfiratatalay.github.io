---
import CollectionsSidebar from '../../components/content/CollectionsSidebar.astro';
import Window from '../../components/desktop/Window.astro';
import AppIcon from '../../components/icons/AppIcon.tsx';
import FolderIcon from '../../components/icons/FolderIcon.astro';
import DesktopLayout from '../../layouts/DesktopLayout.astro';
import { getNoteSources } from '../../lib/content/collections.ts';
import { categoryLabel } from '../../lib/content/site-data.ts';
import { paths } from '../../lib/content/urls.ts';
import { folderColor } from '../../lib/site/folder-colors.ts';

const sources = await getNoteSources();
const total = sources.reduce((sum, source) => sum + source.notes.length, 0);
---

<DesktopLayout title="Öğrenme Notları" description="Java, Spring Boot, Docker ve diğer konularda tuttuğum öğrenme notları." section="notes">
  <Window id="main" variant="main" title="Öğrenme Notları" icon="notes" section="notes" closeHref="/" backHref="/" backLabel="Masaüstü">
    <CollectionsSidebar slot="sidebar" sources={sources} />

    <header class="page-head">
      <p class="page-head__eyebrow"><AppIcon name="notes" /> Öğrenme Notları</p>
      <h1 class="page-title">Not koleksiyonları</h1>
      <p class="page-lead">
        {total > 0 ? `${sources.length} koleksiyonda ${total} not. Bir klasörü açarak bölümleri görebilirsin.` : 'Henüz yayınlanmış not yok.'}
      </p>
    </header>

    {
      sources.length > 0 ? (
        <ul class="finder-grid">
          {sources.map((source, index) => (
            <li>
              <a class="finder-item" href={paths.noteSource(source.id)}>
                <FolderIcon color={folderColor(index)} icon="notes" size="large" />
                <span class="finder-item__name">{source.label}</span>
                <span class="finder-item__meta">
                  {source.notes.length} not{source.category ? ` · ${categoryLabel(source.category)}` : ''}
                </span>
                {source.description && <span class="finder-item__desc">{source.description}</span>}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty-state">Notlar eklendiğinde burada klasörler halinde görünecek.</p>
      )
    }
  </Window>
</DesktopLayout>
