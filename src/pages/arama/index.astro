---
import Window from '../../components/desktop/Window.astro';
import SearchPanel from '../../components/search/SearchPanel.tsx';
import DesktopLayout from '../../layouts/DesktopLayout.astro';
import { paths } from '../../lib/content/urls.ts';
---

<DesktopLayout title="Arama" description="Blog yazılarında ve öğrenme notlarında ara." section="search" noindex>
  <Window id="main" variant="main" title="Arama" icon="search" closeHref="/">
    <div class="article">
      <header class="page-header">
        <h1 class="page-title">Arama</h1>
        <p class="page-lead">Yayınlanmış blog yazılarında, öğrenme notlarında ve projelerde başlık ve metin içinde arar.</p>
      </header>
      <SearchPanel client:load syncUrl autoFocus />
      <noscript>
        <p class="empty-state">
          Arama için JavaScript gerekiyor. Bu sırada <a href={paths.blog}>blog yazılarına</a> veya
          <a href={paths.notes}>öğrenme notlarına</a> göz atabilirsin.
        </p>
      </noscript>
    </div>
  </Window>
</DesktopLayout>
