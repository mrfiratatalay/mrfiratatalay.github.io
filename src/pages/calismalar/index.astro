---
import { ChevronRight, Library } from 'lucide-react';
import Window from '../../components/desktop/Window.astro';
import AppIcon from '../../components/icons/AppIcon.tsx';
import DesktopLayout from '../../layouts/DesktopLayout.astro';
import { getPublishedSeries } from '../../lib/content/collections.ts';

const seriesList = await getPublishedSeries();
---

<DesktopLayout title="Çalışmalarım" description="Chapter ve part sırasıyla ilerleyen çalışma serileri." section="series">
  <Window id="main" variant="main" title="Çalışmalarım" icon="series" section="series" closeHref="/" backHref="/" backLabel="Masaüstü">
    <nav slot="sidebar" class="sidebar-section" aria-label="Seriler">
      <p class="sidebar-heading">Seriler</p>
      <ul class="sidebar-list">
        {
          seriesList.map((series) => (
            <li>
              <a class="sidebar-link" href={`#${series.id}`}>
                <Library aria-hidden="true" />
                {series.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <header class="page-head">
      <p class="page-head__eyebrow"><AppIcon name="series" /> Çalışmalarım</p>
      <h1 class="page-title">Çalışma serileri</h1>
      <p class="page-lead">Uzun konuları chapter ve part sırasıyla takip edebileceğin seriler. Her part, ilgili yazının veya notun kendi sayfasını açar.</p>
    </header>

    {
      seriesList.length === 0 ? (
        <p class="empty-state">Henüz yayınlanmış çalışma serisi yok.</p>
      ) : (
        seriesList.map((series) => {
          let number = 0;
          const parts = series.chapters.reduce((sum, chapter) => sum + chapter.parts.length, 0);
          return (
            <section class="series-block" id={series.id} aria-labelledby={`${series.id}-baslik`}>
              <div class="series-block__head">
                <AppIcon name="series" />
                <div>
                  <h2 id={`${series.id}-baslik`}>{series.title}</h2>
                  <p>
                    {series.chapters.length} chapter · {parts} part
                  </p>
                </div>
              </div>
              {series.description && <p class="muted" style="margin: 0 0 6px;">{series.description}</p>}
              {series.chapters.map((chapter) => (
                <div>
                  <h3 class="chapter-title">{chapter.title}</h3>
                  <ol class="group">
                    {chapter.parts.map((part) => {
                      number += 1;
                      return (
                        <li>
                          <a class="group__row" href={part.url}>
                            <span class="part-number">{number}</span>
                            <span class="group__text">
                              <span class="group__title">{part.title}</span>
                              <span class="group__subtitle">{part.kind}</span>
                            </span>
                            <ChevronRight className="group__chevron" aria-hidden="true" />
                          </a>
                        </li>
                      );
                    })}
                  </ol>
                </div>
              ))}
            </section>
          );
        })
      )
    }
  </Window>
</DesktopLayout>
