---
import ProjectCard from '../../components/content/ProjectCard.astro';
import Window from '../../components/desktop/Window.astro';
import AppIcon from '../../components/icons/AppIcon.tsx';
import DesktopLayout from '../../layouts/DesktopLayout.astro';
import { getPublishedProjects } from '../../lib/content/collections.ts';

const projects = await getPublishedProjects();
---

<DesktopLayout title="Projelerim" description="Geliştirdiğim projeler, kullandığım teknolojiler ve kaynak kodları." section="projects">
  <Window id="main" variant="main" title="Projelerim" icon="projects" section="projects" closeHref="/" backHref="/" backLabel="Masaüstü">
    <header class="page-head">
      <p class="page-head__eyebrow"><AppIcon name="projects" /> Projelerim</p>
      <h1 class="page-title">Geliştirdiğim projeler</h1>
      <p class="page-lead">Ayrıntılar, kaynak kod ve varsa tanıtım videosu her projenin kendi sayfasında.</p>
    </header>
    {
      projects.length > 0 ? (
        <ul class="card-grid">
          {projects.map((project) => (
            <li>
              <ProjectCard project={project} />
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty-state">Henüz yayınlanmış proje yok.</p>
      )
    }
  </Window>
</DesktopLayout>
