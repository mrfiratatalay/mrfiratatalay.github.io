---
import Window from '../components/desktop/Window.astro';
import DesktopLayout from '../layouts/DesktopLayout.astro';
import { paths } from '../lib/content/urls.ts';
---

<DesktopLayout title="Sayfa bulunamadı" description="Aradığın sayfa bulunamadı." section="notfound" noindex>
  <Window id="main" variant="main" title="Bulunamadı" icon="search" closeHref="/">
    <div class="article">
      <header class="page-header">
        <p class="badge">404</p>
        <h1 class="page-title" style="margin-top: 12px;">Bu sayfa bulunamadı</h1>
        <p class="page-lead">Adres yanlış yazılmış olabilir ya da sayfa taşınmış olabilir. Aşağıdaki bağlantılarla devam edebilirsin.</p>
      </header>
      <div class="action-row">
        <a class="button button--primary" href={paths.home}>Masaüstüne dön</a>
        <a class="button" href={paths.blog}>Blog</a>
        <a class="button" href={paths.notes}>Öğrenme notları</a>
        <a class="button" href={paths.search}>Arama</a>
      </div>
    </div>
  </Window>
</DesktopLayout>
