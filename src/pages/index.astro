---
import { BriefcaseBusiness } from 'lucide-react';
import HomeApps from '../components/desktop/HomeApps.astro';
import WelcomeNotification from '../components/desktop/WelcomeNotification.astro';
import Widgets from '../components/desktop/Widgets.astro';
import Window from '../components/desktop/Window.astro';
import AppIcon from '../components/icons/AppIcon.tsx';
import DesktopLayout from '../layouts/DesktopLayout.astro';
import { getNoteSources, getPublishedPosts, getPublishedProjects, getPublishedSeries } from '../lib/content/collections.ts';
import { initials, profile } from '../lib/content/site-data.ts';
import { paths } from '../lib/content/urls.ts';

const [posts, sources, projects, series] = await Promise.all([
  getPublishedPosts(),
  getNoteSources(),
  getPublishedProjects(),
  getPublishedSeries(),
]);
const noteCount = sources.reduce((sum, source) => sum + source.notes.length, 0);
const site = Astro.site ?? new URL('https://mrfiratatalay.github.io');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: profile.name,
  url: site.toString(),
  inLanguage: 'tr-TR',
  description: profile.siteDescription,
  author: {
    '@type': 'Person',
    name: profile.name,
    url: new URL(paths.about, site).toString(),
    sameAs: profile.links.map((link) => link.url),
  },
};
---

<DesktopLayout title={profile.name} description={profile.siteDescription} section="home" home jsonLd={jsonLd}>
  <Widgets posts={posts.slice(0, 3)} noteCount={noteCount} collectionCount={sources.length} projectCount={projects.length} />

  <Window id="intro" variant="intro" title="Hoş geldin" icon="home" section="home">
    <div class="welcome">
      <div class="welcome__hero">
        {
          profile.avatar ? (
            <img class="welcome__avatar" src={profile.avatar} alt={profile.avatarAlt ?? ''} width="86" height="86" />
          ) : (
            <span class="welcome__avatar avatar-initials" aria-hidden="true">
              {initials(profile.name)}
            </span>
          )
        }
        <div>
          <h1 class="welcome__name">{profile.name}</h1>
          <p class="welcome__title"><span class="pill">{profile.title}</span></p>
        </div>
      </div>
      <p class="welcome__bio">{profile.shortBio}</p>
      <div class="welcome__actions">
        <a class="button button--primary" href={paths.projects}>
          <BriefcaseBusiness aria-hidden="true" />
          Projelerimi gör
        </a>
        <a class="button" href={paths.about}>Hakkımda</a>
        <a class="button" href={paths.contact}>İletişime geç</a>
      </div>
      <ul class="welcome__apps">
        <li>
          <a class="welcome-app" href={paths.blog}>
            <AppIcon name="blog" />
            <span><strong>Blog</strong><span>{posts.length} yazı</span></span>
          </a>
        </li>
        <li>
          <a class="welcome-app" href={paths.notes}>
            <AppIcon name="notes" />
            <span><strong>Notlar</strong><span>{noteCount} not</span></span>
          </a>
        </li>
        <li>
          <a class="welcome-app" href={paths.series}>
            <AppIcon name="series" />
            <span><strong>Çalışmalar</strong><span>{series.length} seri</span></span>
          </a>
        </li>
      </ul>
      <p class="muted no-js-only" style="margin: 0;">Bir klasöre tıklayarak içerikleri açabilirsin.</p>
    </div>
  </Window>

  <HomeApps />
  <WelcomeNotification />
</DesktopLayout>
