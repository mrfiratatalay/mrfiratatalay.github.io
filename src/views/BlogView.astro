---
import { FolderOpen, Rss, Tag } from 'lucide-react';
import PostCard from '../components/content/PostCard.astro';
import Window from '../components/desktop/Window.astro';
import AppIcon from '../components/icons/AppIcon.tsx';
import DesktopLayout from '../layouts/DesktopLayout.astro';
import { getNoteSources, getPublishedPosts } from '../lib/content/collections.ts';
import { categoryLabel, taxonomy } from '../lib/content/site-data.ts';
import { localePaths } from '../lib/content/urls.ts';
import type { Locale } from '../lib/i18n/locales.ts';
import { useTranslations } from '../lib/i18n/ui.ts';
import BlogNoteCard from './BlogNoteCard.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
const paths = localePaths(locale);
const [posts, sources] = await Promise.all([getPublishedPosts(), getNoteSources(locale)]);
const entries = [
  ...posts.map((post) => ({ kind: 'post' as const, category: post.data.category, post })),
  ...sources.flatMap((source) => source.notes.map((note) => ({ kind: 'note' as const, category: note.category ?? 'genel', note, sourceLabel: source.label }))),
];
const categories = taxonomy.categories
  .map((category) => ({ id: category.id, label: categoryLabel(category.id, locale), count: entries.filter((entry) => entry.category === category.id).length }))
  .filter((category) => category.count > 0);
const lead = locale === 'en'
  ? 'My Java, Spring Boot and Docker learning notes, code examples and visual summaries, together with my articles.'
  : 'Java, Spring Boot ve Docker öğrenme notlarım, kod örneklerim ve görsel özetlerim; makalelerimle birlikte burada.';
---

<DesktopLayout locale={locale} title={t.blog.title} description={lead} section="blog">
  <Window locale={locale} id="main" variant="main" title={t.blog.title} icon="blog" section="blog" closeHref={paths.home} backHref={paths.home} backLabel={t.sections.home.label}>
    <Fragment slot="sidebar">
      <nav class="sidebar-section" aria-label={t.blog.categories}>
        <p class="sidebar-heading">{t.blog.categories}</p>
        <ul class="sidebar-list">
          <li><a class="sidebar-link" href={paths.blog} data-category-filter="" aria-current="page"><Tag aria-hidden="true" />{t.blog.allPosts}<span class="count">{entries.length}</span></a></li>
          {categories.map((category) => (
            <li><a class="sidebar-link" href={`${paths.blog}?kategori=${category.id}`} data-category-filter={category.id}><Tag aria-hidden="true" />{category.label}<span class="count">{category.count}</span></a></li>
          ))}
        </ul>
      </nav>
      {sources.length > 0 && (
        <nav class="sidebar-section" aria-label={t.notes.collectionsLabel}>
          <p class="sidebar-heading">{t.notes.collections}</p>
          <ul class="sidebar-list">{sources.map((source) => (
            <li><a class="sidebar-link" href={paths.noteSource(source.id)}><FolderOpen aria-hidden="true" />{source.label}<span class="count">{source.notes.length}</span></a></li>
          ))}</ul>
        </nav>
      )}
      <nav class="sidebar-section" aria-label={t.blog.follow}>
        <p class="sidebar-heading">{t.blog.follow}</p>
        <ul class="sidebar-list"><li><a class="sidebar-link" href={paths.rss}><Rss aria-hidden="true" />{t.blog.rss}</a></li></ul>
      </nav>
    </Fragment>

    <header class="page-head">
      <p class="page-head__eyebrow"><AppIcon name="blog" />{t.blog.title}</p>
      <h1 class="page-title">{t.blog.heading}</h1>
      <p class="page-lead">{lead}</p>
    </header>

    {categories.length > 1 && (
      <ul class="filter-bar filter-bar--compact" aria-label={t.blog.filter}>
        <li><a href={paths.blog} data-category-filter="" aria-pressed="true">{t.blog.all}<span class="blog-filter-count">{entries.length}</span></a></li>
        {categories.map((category) => (
          <li><a href={`${paths.blog}?kategori=${category.id}`} data-category-filter={category.id} aria-pressed="false">{category.label}<span class="blog-filter-count">{category.count}</span></a></li>
        ))}
      </ul>
    )}

    {entries.length === 0 ? <p class="empty-state">{t.blog.empty}</p> : (
      <ul class="card-grid" data-post-list>
        {entries.map((entry, index) => (
          <li data-category={entry.category} class:list={{ 'card-grid__wide': index === 0 }}>
            {entry.kind === 'post'
              ? <PostCard locale={locale} post={entry.post} featured={index === 0} />
              : <BlogNoteCard locale={locale} note={entry.note} sourceLabel={entry.sourceLabel} featured={index === 0} />}
          </li>
        ))}
      </ul>
    )}
    <p class="empty-state" data-filter-empty hidden>{t.blog.emptyCategory}</p>
  </Window>
</DesktopLayout>

<style>
  .blog-filter-count { margin-inline-start: 7px; font-size: 0.75rem; opacity: 0.7; }
  [data-post-list] > [hidden] { display: none; }
</style>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-category-filter]')];
  const items = [...document.querySelectorAll<HTMLElement>('[data-post-list] > [data-category]')];
  const empty = document.querySelector<HTMLElement>('[data-filter-empty]');
  const valid = new Set(links.map((link) => link.dataset.categoryFilter ?? ''));

  function apply(requested: string) {
    const category = valid.has(requested) ? requested : '';
    let visible = 0;
    for (const item of items) {
      const show = !category || item.dataset.category === category;
      item.hidden = !show;
      if (show) visible += 1;
    }
    if (empty) empty.hidden = visible > 0 || items.length === 0;
    for (const link of links) {
      const active = (link.dataset.categoryFilter ?? '') === category;
      if (link.closest('.filter-bar')) link.setAttribute('aria-pressed', String(active));
      else if (active) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    }
  }

  for (const link of links) {
    link.addEventListener('click', (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      const category = link.dataset.categoryFilter ?? '';
      const url = new URL(window.location.href);
      if (category) url.searchParams.set('kategori', category);
      else url.searchParams.delete('kategori');
      window.history.pushState(null, '', url);
      apply(category);
    });
  }
  const fromAddress = () => apply(new URLSearchParams(window.location.search).get('kategori') ?? '');
  window.addEventListener('popstate', fromAddress);
  fromAddress();
</script>
