---
import { privacy } from '../../data/studywithme/privacy';
import { support } from '../../data/studywithme/support';
import { profile } from '../../lib/content/site-data';
import {
  helpLanguages, helpLocales, helpPath, productPath, type HelpLocale, type HelpPage,
} from '../../lib/studywithme/help-links';

interface Props {
  locale: HelpLocale;
  page: HelpPage;
}

const { locale, page } = Astro.props;
const supportCopy = support[locale];
const privacyCopy = privacy[locale];
const { title, intro } = page === 'privacy' ? privacyCopy : supportCopy;
const otherPage = page === 'privacy' ? 'support' : 'privacy';
const otherTitle = otherPage === 'support' ? supportCopy.title : privacyCopy.title;
const mail = `mailto:${profile.email}`;
const canonical = (language: HelpLocale) => new URL(helpPath(language, page), Astro.site ?? Astro.url);
const languagesLabel = {
  tr: 'Sayfa dili', en: 'Page language', de: 'Seitensprache', fr: 'Langue de la page',
  es: 'Idioma de la página', it: 'Lingua della pagina', 'pt-BR': 'Idioma da página',
  ja: 'ページの言語', ko: '페이지 언어', 'zh-Hans': '页面语言', 'zh-Hant': '頁面語言', ar: 'لغة الصفحة',
}[locale];
---

<!doctype html>
<html lang={locale} dir={locale === 'ar' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f3e7" />
    <meta name="description" content={intro} />
    <link rel="canonical" href={canonical(locale)} />
    {helpLocales.map((language) => (
      <link rel="alternate" hreflang={language} href={canonical(language)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={canonical('tr')} />
    <link rel="icon" type="image/webp" href="/studywithme/images/app-icon.webp" />
    <title>{title} · Tao: Cozy Focus Timer</title>
  </head>
  <body class="study-help">
    <div class="help-frame">
      <nav class="help-top" aria-label="Tao: Cozy Focus Timer">
        <a class="brand" href={productPath(locale)}>
          <img src="/studywithme/images/app-icon.webp" width="39" height="39" alt="" />
          <span>Tao: Cozy Focus Timer</span>
        </a>
        <a class="section-link" href={helpPath(locale, otherPage)}>{otherTitle}</a>
      </nav>

      <main class="help-sheet">
        <header class="sheet-heading">
          <h1>{title}</h1>
          <p class="intro">{intro}</p>
        </header>

        {page === 'support' ? (
          <>
            <section class="contact-note" aria-labelledby="contact-title">
              <h2 id="contact-title">{supportCopy.contactTitle}</h2>
              <p><a class="email" href={mail} dir="ltr">{profile.email}</a></p>
              <p>{supportCopy.contactDetails}</p>
            </section>
            {supportCopy.guides.map(([heading, explanation], index) => (
              <section class="help-entry" aria-labelledby={`guide-${index}`}>
                <h2 id={`guide-${index}`}>{heading}</h2>
                <p>{explanation}</p>
              </section>
            ))}
            <p class="reference"><a href="https://support.apple.com/108096">{supportCopy.appleHelp} <span aria-hidden="true">↗</span></a></p>
          </>
        ) : (
          <>
            <section class="help-entry" aria-labelledby="local-title">
              <h2 id="local-title">{privacyCopy.device[0]}</h2>
              <p>{privacyCopy.device[1]}</p>
            </section>
            <section class="help-entry" aria-labelledby="purchase-title">
              <h2 id="purchase-title">{privacyCopy.purchases[0]}</h2>
              <p>{privacyCopy.purchases[1]}</p>
              <p class="reference"><a href="https://www.apple.com/legal/privacy/data/en/appstore/">Apple App Store <span aria-hidden="true">↗</span></a></p>
            </section>
            <section class="help-entry" aria-labelledby="retention-title">
              <h2 id="retention-title">{privacyCopy.removal[0]}</h2>
              <p>{privacyCopy.removal[1]}</p>
            </section>
            <section class="help-entry" aria-labelledby="privacy-contact-title">
              <h2 id="privacy-contact-title">{privacyCopy.email[0]}</h2>
              <p>{privacyCopy.email[1]}</p>
              <p class="reference privacy-contacts">
                <a class="email" href={mail} dir="ltr">{profile.email}</a>
                <a href="https://policies.google.com/privacy">Google (Gmail) <span aria-hidden="true">↗</span></a>
              </p>
            </section>
            <section class="help-entry" aria-labelledby="site-title">
              <h2 id="site-title">{privacyCopy.website[0]}</h2>
              <p>{privacyCopy.website[1]}</p>
              <p class="reference"><a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement">GitHub <span aria-hidden="true">↗</span></a></p>
            </section>
          </>
        )}
      </main>

      <footer class="help-footer">
        <nav aria-label={languagesLabel}>
          <ul>
            {helpLocales.map((language) => (
              <li>
                <a
                  lang={language}
                  hreflang={language}
                  dir={language === 'ar' ? 'rtl' : 'ltr'}
                  href={helpPath(language, page)}
                  aria-current={language === locale ? 'page' : undefined}
                >{helpLanguages[language]}</a>
              </li>
            ))}
          </ul>
        </nav>
        <p>Tao: Cozy Focus Timer <span aria-hidden="true">·</span> Fırat Atalay</p>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: 'Study Help Hand';
    src: url('/studywithme/fonts/shantellsans-semibold.ttf') format('truetype');
    font-weight: 600;
    font-display: swap;
  }

  body.study-help {
    --help-paper: #f8f3e7;
    --help-ink: #2b2a22;
    --help-accent: #3d5a46;
    --help-line: #ddd0b8;
    --help-hand: 'Study Help Hand', ui-rounded, system-ui, sans-serif;
    margin: 0;
    min-height: 100vh;
    color: var(--help-ink);
    background: #eae3d4;
    background-image: radial-gradient(ellipse at 20% 0%, #f6ead4, transparent 36rem);
    font: 400 1rem/1.65 system-ui, sans-serif;
  }
</style>

<style>
  .help-frame {
    box-sizing: border-box;
    max-width: 53rem;
    margin-inline: auto;
    padding: 1.25rem clamp(1rem, 4vw, 2.5rem) 2.5rem;
  }

  .help-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .8rem 1.25rem;
    flex-wrap: wrap;
    margin-block-end: 1.1rem;
  }

  a { color: var(--help-accent); text-underline-offset: .22em; }
  a:focus-visible { outline: .15rem solid var(--help-accent); outline-offset: .25rem; }

  .brand {
    display: inline-flex;
    gap: .65rem;
    align-items: center;
    color: var(--help-ink);
    font: 600 1.18rem/1.25 var(--help-hand);
    text-decoration: none;
  }

  .brand img { border-radius: 22%; box-shadow: 0 .12rem .3rem #38332529; }

  .section-link {
    padding: .32rem .8rem;
    border: 1px solid #b8c6ab;
    border-radius: .5rem .6rem .55rem .65rem;
    background: #e4ead8;
    font-weight: 600;
  }

  .help-sheet {
    padding: clamp(1.4rem, 6vw, 3.6rem);
    border: 1px solid var(--help-line);
    border-radius: .5rem .36rem .75rem .45rem;
    background: var(--help-paper);
    box-shadow: .2rem .3rem 0 #dfd3bf, 0 .65rem 1.4rem #53473512;
  }

  .sheet-heading {
    border-block-end: 1px solid var(--help-line);
    padding-block-end: 1.35rem;
  }

  h1, h2 { color: var(--help-ink); font-family: var(--help-hand); font-weight: 600; }
  h1 { margin: 0 0 .6rem; font-size: clamp(2rem, 6vw, 3.5rem); line-height: 1.14; }
  h2 { margin: 0 0 .4rem; font-size: clamp(1.18rem, 2.6vw, 1.38rem); line-height: 1.35; }
  p { margin: 0; }
  .intro { color: #504c3e; font-size: clamp(1.03rem, 2.5vw, 1.15rem); }

  .help-entry { margin-block-start: 1.6rem; }
  .reference { margin-block-start: .65rem; font-size: .94rem; }
  .email { display: inline-block; overflow-wrap: anywhere; font-weight: 650; }
  .privacy-contacts { display: flex; flex-wrap: wrap; gap: .3rem 1rem; }
  .contact-note {
    margin-block: 1.5rem 1.75rem;
    padding: 1.05rem 1.2rem;
    border: 1px solid #c4cdb4;
    border-radius: .3rem .5rem .42rem .55rem;
    background: #e9eddd;
  }
  .contact-note p + p { margin-block-start: .4rem; }

  .help-footer { padding: 1.3rem .1rem 0; font-size: .9rem; }
  .help-footer ul { display: flex; flex-wrap: wrap; gap: .15rem .85rem; margin: 0 0 .75rem; padding: 0; list-style: none; }
  .help-footer a { display: inline-block; padding-block: .15rem; }
  .help-footer a[aria-current='page'] { color: var(--help-ink); text-decoration: none; font-weight: 700; }
  .help-footer p { color: #514b3d; }
</style>
