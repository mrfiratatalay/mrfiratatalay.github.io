{
  "name": "mrfiratatalay-github-io",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "macOS masaüstünden ilham alan kişisel portfolyo, blog ve öğrenme notları sitesi",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:ornek": "npm run sync:notes -- --ornek && astro dev",
    "sync:notes": "node scripts/import-notes.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "check": "astro check",
    "build": "npm run sync:notes && npm run validate:content && astro build && pagefind --site dist",
    "build:ornek": "npm run sync:notes -- --ornek && npm run validate:content && astro build && pagefind --site dist",
    "preview": "astro preview",
    "test": "node --test \"tests/content/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "astro": "astro"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/react": "^7.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.6",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "github-slugger": "^2.0.0",
    "hast-util-sanitize": "^5.0.2",
    "hast-util-to-string": "^3.0.1",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-string": "^4.0.0",
    "micromark": "^4.0.3",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-util-decode-string": "^2.0.1",
    "pagefind": "^1.5.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "sharp": "^0.35.5",
    "tinyglobby": "^0.2.17",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3",
    "yaml": "^2.9.1"
  }
}
